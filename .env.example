# ---- LLM / embedding providers (see docs on the provider factory) ----
LLM_PROVIDER=gemini            # gemini | anthropic | openai | fake
EMBED_PROVIDER=gemini          # gemini | openai | fake   (Anthropic has no embeddings API)
LLM_MODEL=gemini-2.5-flash     # model id for the chosen LLM provider
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072                 # must match the vector column; changing it requires a new migration
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Storage ----
# Empty DATABASE_URL = local SQLite file at MEMORY_DB (offline dev/tests). Set it to use Postgres + pgvector.
DATABASE_URL=
MEMORY_DB=data/memory.db
LLM_CACHE=data/llm_cache.db    # on-disk LLM response cache (cuts cost on repeated runs); empty disables

# ---- Docker Compose (host side) ----
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory
POSTGRES_PORT=5439
API_PORT=8090

# ---- Service ----
TENANT_ID=default              # default tenant for the CLI
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
JOB_VISIBILITY_TIMEOUT_SECONDS=300
